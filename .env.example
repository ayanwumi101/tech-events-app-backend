NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventscout?schema=public"

JWT_ACCESS_SECRET="replace-with-a-long-random-secret-for-access"
JWT_REFRESH_SECRET="replace-with-a-long-random-secret-for-refresh"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
OTP_EXPIRY_MINUTES=10

CLIENT_DEEP_LINK_SCHEME="eventscout://"
WEB_DEEP_LINK_BASE="https://eventscout.app"

AI_PROVIDER="gemini"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
EVENTBRITE_API_TOKEN=""
MEETUP_API_KEY=""
SERPAPI_API_KEY=""
BRAVE_SEARCH_API_KEY=""
X_API_BEARER_TOKEN=""
HASHNODE_PUBLICATION_HOSTS="engineering.hashnode.com,blog.developerdao.com"
RSS_SOURCE_FEEDS="https://blog.google/rss/,https://openai.com/news/rss.xml,https://github.blog/feed/"
INGESTION_INTERVAL_MINUTES=30
INGESTION_USE_AI_VALIDATION=true
INGESTION_VALIDATION_MIN_SCORE=0.6
SCRAPE_REQUEST_TIMEOUT_MS=12000
SCRAPE_MAX_LINKS_PER_SOURCE=4
SCRAPE_MAX_SOURCES_PER_RUN=20

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="eventscout/events"

RESEND_API_KEY=""
RESEND_FROM_EMAIL="EventScout <noreply@yourdomain.com>"

ALLOWED_ORIGINS="*"
