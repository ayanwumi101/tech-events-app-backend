NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eventscout?schema=public"

JWT_ACCESS_SECRET="replace-with-a-long-random-secret-for-access"
JWT_REFRESH_SECRET="replace-with-a-long-random-secret-for-refresh"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=30
OTP_EXPIRY_MINUTES=10

CLIENT_DEEP_LINK_SCHEME="eventscout://"
WEB_DEEP_LINK_BASE="https://eventscout.app"

AI_PROVIDER="gemini"
OPENAI_API_KEY=""
GEMINI_API_KEY=""
TAVILY_API_KEY=""
EVENTBRITE_API_TOKEN=""
SERPAPI_API_KEY=""
BRAVE_SEARCH_API_KEY=""
X_API_BEARER_TOKEN=""
# Hashnode publication hosts — only add hosts that publish event listings, not blogs.
# Leave blank to disable Hashnode collection.
HASHNODE_PUBLICATION_HOSTS=""
# RSS feeds that contain event listings (not blog posts). Leave blank to disable.
# Example: "https://events.yourorg.com/feed/,https://confcalendar.example.com/rss"
RSS_SOURCE_FEEDS=""
# Runs every night at midnight by default.
INGESTION_CRON_EXPRESSION="0 0 * * *"
INGESTION_USE_AI_VALIDATION=true
INGESTION_VALIDATION_MIN_SCORE=0.6
SCRAPE_REQUEST_TIMEOUT_MS=12000
SCRAPE_MAX_LINKS_PER_SOURCE=4
SCRAPE_MAX_SOURCES_PER_RUN=20

CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="eventscout/events"
# Override to use your own branded placeholder for events that have no image.
EVENT_PLACEHOLDER_IMAGE_URL="https://images.unsplash.com/photo-1591453089343-3fbf5cce2c70?auto=format&fit=crop&w=1200&q=80"

RESEND_API_KEY=""
RESEND_FROM_EMAIL="EventScout <noreply@yourdomain.com>"

ALLOWED_ORIGINS="*"
